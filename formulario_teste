<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Inventário Privado</title>

  <style>
    * { box-sizing: border-box; }
    body { margin: 0; font-family: system-ui, -apple-system, BlinkMacSystemFont, sans-serif; background: #f2f2f2; }

    /* HEADER */
    header {
      position: relative;
      height: 35vh;
      min-height: 250px;
      background: url('https://i.imgur.com/O7EWNiI.jpeg') center / cover no-repeat fixed;
      display: flex;
      justify-content: center;
      align-items: center;
      color: white;
      text-align: center;
      z-index: 1;
    }

    header::after {
      content: "";
      position: absolute;
      inset: 0;
      background: rgba(0,0,0,0.5);
    }

    header h1 {
      position: relative;
      z-index: 2;
      font-size: clamp(1.8rem, 5vw, 2.5rem);
      margin: 0;
      text-shadow: 2px 2px 10px rgba(0,0,0,0.5);
    }

    /* AREA DE LOGIN */
    #authSection {
      position: relative;
      z-index: 3;
      text-align: center;
      margin-top: -30px;
    }

    .btn-google {
      background: #ffffff;
      color: #444;
      border: 1px solid #ccc;
      padding: 12px 24px;
      border-radius: 8px;
      font-weight: bold;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.1);
      transition: 0.3s;
    }

    .btn-google:hover { background: #f9f9f9; transform: translateY(-2px); }

    .btn-logout {
      background: #ff4d4d;
      color: white;
      border: none;
      padding: 8px 16px;
      border-radius: 6px;
      cursor: pointer;
      margin-top: 10px;
    }

    /* FORMULÁRIO (Escondido por padrão) */
    main {
      display: none; /* Só aparece após login */
      position: relative;
      z-index: 2;
      width: 90%;
      max-width: 620px;
      margin: 20px auto 50px;
      background: #ffffff;
      border-radius: 14px;
      padding: 24px;
      box-shadow: 0 12px 35px rgba(0,0,0,0.1);
    }

    main h2 { text-align: center; margin-top: 0; color: #333; }

    form { display: grid; gap: 14px; }
    input, textarea {
      width: 100%;
      padding: 12px;
      border-radius: 6px;
      border: 1px solid #ccc;
      font-size: 1rem;
    }

    .checkbox-group {
      display: flex;
      gap: 20px;
      grid-column: span 2;
      background: #f9f9f9;
      padding: 15px;
      border-radius: 8px;
    }

    .switch-container { display: flex; align-items: center; gap: 8px; }

    /* SWITCH CSS */
    .switch { position: relative; display: inline-block; width: 40px; height: 22px; }
    .switch input { opacity: 0; width: 0; height: 0; }
    .slider {
      position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0;
      background-color: #ccc; transition: .4s; border-radius: 34px;
    }
    .slider:before {
      position: absolute; content: ""; height: 16px; width: 16px; left: 3px; bottom: 3px;
      background-color: white; transition: .4s; border-radius: 50%;
    }
    input:checked + .slider { background-color: #1f1f1f; }
    input:checked + .slider:before { transform: translateX(18px); }

    .btn-submit {
      background: #1f1f1f;
      color: white;
      border: none;
      padding: 15px;
      border-radius: 8px;
      font-weight: bold;
      cursor: pointer;
      font-size: 1rem;
    }

    @media (min-width: 600px) {
      form { grid-template-columns: 1fr 1fr; }
      textarea, .btn-submit, input[type="url"], .checkbox-group { grid-column: span 2; }
    }
  </style>
</head>
<body>

<header>
  <h1>Coleção Pessoal</h1>
</header>

<div id="authSection">
  <button id="btnLogin" class="btn-google">
    <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" width="20">
    Aceder com Google
  </button>
  <div id="userInfo" style="display:none;">
    <span id="userEmail" style="font-weight: bold;"></span><br>
    <button id="btnLogout" class="btn-logout">Sair do Sistema</button>
  </div>
</div>

<main id="mainContent">
  <h2>Novo Item</h2>
  <form id="colecaoForm">
    <input type="text" id="colecao" placeholder="Coleção" required />
    <input type="text" id="nomeNaColecao" placeholder="Nome na Coleção" required />
    <input type="number" id="numeroNaColecao" placeholder="Número" />
    <input type="text" id="marca" placeholder="Marca" />
    <input type="text" id="pertence" placeholder="Pertence a" />
    <input type="text" id="editora" placeholder="Editora" />
    <input type="text" id="loja" placeholder="Loja" />
    <input type="number" step="0.01" id="preco" placeholder="Preço" />
    <input type="text" id="tipo" placeholder="Tipo (ex: Estátua, Livro)" />
    <input type="date" id="dataDeCompra" />

    <div class="checkbox-group">
      <div class="switch-container">
        <span>Colecionado:</span>
        <label class="switch">
          <input type="checkbox" id="colecionado">
          <span class="slider"></span>
        </label>
      </div>
      <div class="switch-container">
        <span>Adquirido:</span>
        <label class="switch">
          <input type="checkbox" id="origem">
          <span class="slider"></span>
        </label>
      </div>
    </div>

    <textarea id="descricao" placeholder="Observações adicionais..."></textarea>
    <input type="url" id="imagem1" placeholder="Link Imagem 1" required />
    <input type="url" id="imagem2" placeholder="Link Imagem 2" required />

    <button type="submit" class="btn-submit" id="btnSalvar">Salvar no Inventário</button>
  </form>
</main>

<script type="module">
  import { initializeApp } from "https://www.gstatic.com/firebasejs/9.23.0/firebase-app.js";
  import { getFirestore, collection, addDoc, Timestamp } from "https://www.gstatic.com/firebasejs/9.23.0/firebase-firestore.js";
  import { getAuth, signInWithPopup, GoogleAuthProvider, onAuthStateChanged, signOut } from "https://www.gstatic.com/firebasejs/9.23.0/firebase-auth.js";

  const firebaseConfig = {
    apiKey: "AIzaSyCDbqy7cBEBkIkhiD4dzbhVKq4leduVEYE",
    authDomain: "miguel-inventory.firebaseapp.com",
    projectId: "miguel-inventory",
    storageBucket: "miguel-inventory.firebasestorage.app",
    messagingSenderId: "277968569414",
    appId: "1:277968569414:web:04884bc1932c2c7dbb6b647"
  };

  const app = initializeApp(firebaseConfig);
  const db = getFirestore(app);
  const auth = getAuth(app);
  const provider = new GoogleAuthProvider();

  // --- CONFIGURAÇÃO DE SEGURANÇA ---
  const emailAutorizado = "ulisses.dos.santos@gmail.com"; // SUBSTITUA PELO SEU EMAIL

  const btnLogin = document.getElementById("btnLogin");
  const btnLogout = document.getElementById("btnLogout");
  const userInfo = document.getElementById("userInfo");
  const userEmailSpan = document.getElementById("userEmail");
  const mainContent = document.getElementById("mainContent");
  const form = document.getElementById("colecaoForm");

  // Monitor de Autenticação
  onAuthStateChanged(auth, (user) => {
    if (user) {
      if (user.email === emailAutorizado) {
        mainContent.style.display = "block";
        userInfo.style.display = "block";
        btnLogin.style.display = "none";
        userEmailSpan.innerText = "Sessão: " + user.email;
      } else {
        alert("Acesso Negado. Este e-mail não tem permissão.");
        signOut(auth);
      }
    } else {
      mainContent.style.display = "none";
      userInfo.style.display = "none";
      btnLogin.style.display = "inline-flex";
    }
  });

  // Ações de Login/Sair
  btnLogin.onclick = () => signInWithPopup(auth, provider);
  btnLogout.onclick = () => signOut(auth);

  // Envio do Formulário
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const btn = document.getElementById("btnSalvar");
    btn.innerText = "A guardar...";
    btn.disabled = true;

    const dataValue = document.getElementById("dataDeCompra").value;
    let dataTimestamp = dataValue ? Timestamp.fromDate(new Date(dataValue)) : null;

    try {
      await addDoc(collection(db, "inventario"), {
        Colecao: document.getElementById("colecao").value,
        NomeNaColecao: document.getElementById("nomeNaColecao").value,
        NumeroNaColecao: Number(document.getElementById("numeroNaColecao").value),
        Descricao: document.getElementById("descricao").value,
        Marca: document.getElementById("marca").value,
        Pertence: document.getElementById("pertence").value,
        Editora: document.getElementById("editora").value,
        Loja: document.getElementById("loja").value,
        Preco: Number(document.getElementById("preco").value),
        Tipo: document.getElementById("tipo").value, 
        Colecionado: document.getElementById("colecionado").checked,
        Origem: document.getElementById("origem").checked,
        DatadeCompra: dataTimestamp,
        Imagem: [document.getElementById("imagem1").value, document.getElementById("imagem2").value],
        CriadoEm: Timestamp.now()
      });

      alert("Sucesso! Item adicionado.");
      form.reset();
    } catch (error) {
      console.error(error);
      alert("Erro ao salvar. Verifique as permissões do banco.");
    } finally {
      btn.innerText = "Salvar no Inventário";
      btn.disabled = false;
    }
  });
</script>

</body>
</html>
